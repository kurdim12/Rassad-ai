# RASAD AI - Environment Configuration
# Copy this file to .env and fill in your API keys.
# The platform runs in DEMO mode if no keys are provided.

# Gemini AI (Google AI Studio - free tier available)
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Tavily Web Search (optional - falls back to DuckDuckGo)
# Get a key: https://app.tavily.com/
TAVILY_API_KEY=

# Serper Web Search (optional alternative)
SERPER_API_KEY=

# Server config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Cache TTL (seconds)
CACHE_TTL=3600
